<?xml version="1.0" encoding="utf-8"?>
<!--
  Switchboard foreground: two ports (left/right) joined by a patch cable that
  crosses in the middle - a switchboard "crossbar" routing one port to another.
  Drawn on a 108dp adaptive canvas; keep art within the central ~66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- patch cable: left port -> crossing -> right port -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M34,42 C46,42 62,66 74,66" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M34,66 C46,66 62,42 74,42" />

    <!-- left jacks -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M34,42 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0z" />
    <path android:fillColor="#FFFFFF"
        android:pathData="M34,66 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0z" />
    <!-- inner holes to read as sockets -->
    <path android:fillColor="#2660B2"
        android:pathData="M34,42 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0z" />
    <path android:fillColor="#2660B2"
        android:pathData="M34,66 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0z" />

    <!-- right jacks -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M74,42 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0z" />
    <path android:fillColor="#FFFFFF"
        android:pathData="M74,66 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0z" />
    <path android:fillColor="#2660B2"
        android:pathData="M74,42 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0z" />
    <path android:fillColor="#2660B2"
        android:pathData="M74,66 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0z" />
</vector>
