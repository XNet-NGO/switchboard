<?xml version="1.0" encoding="utf-8"?>
<!-- Switchboard background: a vertical blue gradient with a faint grid,
     evoking a patch panel. 108dp adaptive canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF3B82F6" />
                <item android:offset="1.0" android:color="#FF1E3A8A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- faint grid lines -->
    <path android:strokeColor="#22FFFFFF" android:strokeWidth="1"
        android:pathData="M27,0 V108 M54,0 V108 M81,0 V108 M0,27 H108 M0,54 H108 M0,81 H108" />
</vector>
